# Copy this file to .env.local and fill in real values. Never commit
# .env.local — it's already in .gitignore.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://taxibahraintodammam.com
NEXT_PUBLIC_APP_URL=https://taxibahraintodammam.com

# --- Supabase (admin panel + booking backend) ---
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, bypasses Row Level Security. Never expose
# this to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin auth ---
# Comma-separated list of emails allowed to use /admin. If left empty, any
# authenticated Supabase user is treated as an admin — set this before
# going live.
ADMIN_EMAILS=

# --- Outbound email (lib/mail-server.ts) ---
# Nodemailer over SMTP. Mail is sent FROM booking@ (booking emails) or info@
# (everything else).
#
# Option A (free ImprovMX): one Gmail account sends for both addresses.
# ImprovMX forwards incoming mail to Gmail; in Gmail add booking@ and info@
# under Settings -> Accounts -> "Send mail as", and use a Gmail app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
BOOKING_EMAIL_USER=booking@taxibahraintodammam.com
INFO_EMAIL_USER=info@taxibahraintodammam.com
#
# Option B (ImprovMX paid SMTP): each mailbox logs in as itself. Setting a
# *_EMAIL_PASS makes that mailbox use its own login instead of SMTP_USER.
# SMTP_HOST=smtp.improvmx.com
# BOOKING_EMAIL_PASS=
# INFO_EMAIL_PASS=
EMAIL_DOMAIN=taxibahraintodammam.com
# Where admin notifications (new bookings, contact form, etc.) are delivered.
ADMIN_EMAIL=
# Optional fallback if SMTP isn't configured or fails. Leave empty to use SMTP only.
RESEND_API_KEY=

# --- Internal / cron auth ---
# Random secrets you generate yourself (e.g. `openssl rand -hex 32`).
CRON_SECRET=
INTERNAL_API_SECRET=
